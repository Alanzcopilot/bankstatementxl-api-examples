        "bodyContent": "=<p><b>{{ $('Summary').first().json.statementFile }}</b> is converted.</p>\n<ul>\n<li>Rows: {{ $('Summary').first().json.rows }}</li>\n<li>Rows that don't add up: {{ $('Summary').first().json.rowsNotAddingUp }}</li>\n<li>Totals match the statement: {{ $('Summary').first().json.totalsMatch }}</li>\n<li>Pages used: {{ $('Summary').first().json.pagesUsed }}</li>\n<li>Files: {{ $('Summary').first().json.files }}</li>\n</ul>\n<p>Saved in OneDrive: {{ $('Save to OneDrive').all().map(f => '<a href=\"' + f.json.webUrl + '\">' + f.json.name + '</a>').join(', ') }}</p>",
